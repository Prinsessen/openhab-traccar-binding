		<description>Values and state flags from a Teltonika CAN adapter (ALL-CAN300, LV-CAN200). A value that a
			record does not carry stays as it was: with the tracker's ignition off it sends no CAN values, and
			some values only come while the car is ready to drive.</description>
		<channels>
			<channel id="batteryLevel" typeId="can-battery-level"/>
			<channel id="batteryLevelSeen" typeId="can-seen">
				<label>Battery Level Seen</label>
			</channel>
			<channel id="range" typeId="can-range"/>
			<channel id="rangeSeen" typeId="can-seen">
				<label>Range Seen</label>
			</channel>
			<channel id="odometer" typeId="can-odometer"/>
			<channel id="odometerSeen" typeId="can-seen">
				<label>Odometer Seen</label>
			</channel>
			<channel id="speed" typeId="can-speed"/>
			<channel id="speedSeen" typeId="can-seen">
				<label>Speed Seen</label>
			</channel>
			<channel id="pedal" typeId="can-pedal"/>
			<channel id="pedalSeen" typeId="can-seen">
				<label>Accelerator Pedal Seen</label>
			</channel>
			<channel id="doorFrontLeft" typeId="can-door">
				<label>Door Front Left</label>
			</channel>
			<channel id="doorFrontRight" typeId="can-door">
				<label>Door Front Right</label>
			</channel>
			<channel id="doorRearLeft" typeId="can-door">
				<label>Door Rear Left</label>
			</channel>
			<channel id="doorRearRight" typeId="can-door">
				<label>Door Rear Right</label>
			</channel>
			<channel id="hood" typeId="can-door">
				<label>Hood</label>
			</channel>
			<channel id="trunk" typeId="can-door">
				<label>Trunk</label>
			</channel>
			<channel id="ignition" typeId="can-flag">
				<label>Ignition</label>
			</channel>
			<channel id="keyInserted" typeId="can-flag">
				<label>Key in Ignition</label>
			</channel>
			<channel id="ready" typeId="can-flag">
				<label>Ready to Drive</label>
			</channel>
			<channel id="workMode" typeId="can-work-mode"/>
			<channel id="handbrake" typeId="can-flag">
				<label>Handbrake</label>
			</channel>
			<channel id="footbrake" typeId="can-flag">
				<label>Footbrake</label>
			</channel>
			<channel id="hazardSwitch" typeId="can-flag">
				<label>Hazard Lights Switch</label>
			</channel>
			<channel id="chargeCable" typeId="can-flag">
				<label>Charging Cable Connected</label>
			</channel>
			<channel id="charging" typeId="can-flag">
				<label>Battery Charging</label>
				<description>The car's own charging bit. On the tested car it went off at 98 % while the charger
