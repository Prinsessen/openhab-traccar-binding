	<channel-type id="can-battery-level">
		<item-type>Number:Dimensionless</item-type>
		<label>Battery Level</label>
		<description>AVL 142, Battery Level Percent: the traction battery's state of charge on an electric car.</description>
		<category>BatteryLevel</category>
		<state readOnly="true" pattern="%.0f %%"/>
	</channel-type>

	<channel-type id="can-range">
		<item-type>Number:Length</item-type>
		<label>Range</label>
		<description>AVL 526, Vehicles Range On Battery. Only sent while the car is ready to drive.</description>
		<state readOnly="true" pattern="%.0f km"/>
	</channel-type>

	<channel-type id="can-odometer">
		<item-type>Number:Length</item-type>
		<label>Odometer</label>
		<description>AVL 36, Total Mileage: the car's own odometer. Only sent while the car is ready to drive.</description>
		<state readOnly="true" pattern="%.1f km"/>
	</channel-type>

	<channel-type id="can-speed">
		<item-type>Number:Speed</item-type>
		<label>Speed</label>
		<description>AVL 30, Vehicle Speed from the car. Only sent while the car is ready to drive.</description>
		<state readOnly="true" pattern="%.0f km/h"/>
	</channel-type>

	<channel-type id="can-pedal">
		<item-type>Number:Dimensionless</item-type>
		<label>Accelerator Pedal</label>
		<description>AVL 31, Accelerator Pedal Position.</description>
		<state readOnly="true" pattern="%.0f %%"/>
	</channel-type>

	<channel-type id="can-seen">
		<item-type>DateTime</item-type>
		<label>Seen</label>
		<description>The device time of the last record that carried this value, changed or not - its freshness.
			A value that has stopped coming keeps its last state; this shows how old it is.</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="can-door">
		<item-type>Contact</item-type>
		<label>Door</label>
		<description>From AVL 143, Door Status.</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="can-flag">
		<item-type>Switch</item-type>
		<label>CAN Flag</label>
		<description>One bit of the adapter's state flags. Off means "no" or "not known": the flags carry no
			validity mask, and a car that does not report a signal leaves its bit at 0.</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="can-work-mode">
		<item-type>String</item-type>
		<label>Work Mode</label>
		<description>Private or company mode, as the car reports it.</description>
		<state readOnly="true">
			<options>
				<option value="private">Private</option>
				<option value="company">Company</option>
			</options>
		</state>
	</channel-type>

	<channel-type id="can-gear">
		<item-type>String</item-type>
		<label>Gear</label>
		<description>P, R, N or D from the gear bits; "-" when no gear bit is set (see the thing's "Gear P When
			Switched Off").</description>
		<state readOnly="true">
			<options>
				<option value="P">P</option>
				<option value="R">R</option>
				<option value="N">N</option>
				<option value="D">D</option>
				<option value="-">Unknown</option>
			</options>
		</state>
	</channel-type>

	<channel-type id="can-link" advanced="true">
		<item-type>String</item-type>
		<label>CAN Bus Link</label>
		<description>The adapter's own view of one CAN bus: connected with data, connected without data, not
			connected but needed, not connected and not needed.</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="can-flag-word" advanced="true">
		<item-type>String</item-type>
		<label>Flag Word</label>
		<description>A state flag word in hex with the numbers of its set bits - for identifying a new bit by
			switching something on and off. P4 format (12710/12711/12712) when the tracker sends it, the legacy
			format (47/38) otherwise.</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="can-unmapped-io" advanced="true">
		<item-type>String</item-type>
		<label>Unmapped I/O</label>
		<description>Every io element in the record that neither the CAN decoding nor the tracker itself accounts
			for - where a new field shows up first.</description>
		<state readOnly="true"/>
	</channel-type>

