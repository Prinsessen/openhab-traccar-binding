		<properties>
			<property name="deviceId">Device ID</property>
			<property name="uniqueId">Unique ID</property>
			<property name="name">Device Name</property>
		</properties>

		<config-description>
			<parameter name="deviceId" type="integer" required="true">
				<label>Device ID</label>
				<description>Traccar device ID</description>
			</parameter>
			<parameter name="deviceFamily" type="text">
				<label>Device Family</label>
				<description>Which Teltonika family the tracker belongs to. The same AVL id means different things in
					different families (AVL 113 is the internal battery level on the FMB family and Service Distance
					on the FMx6 family).</description>
				<options>
					<option value="fmb">FMB / FMM / FMC9xx family, or not a Teltonika</option>
					<option value="fmx6">FMx6 family (FMC650 and relatives)</option>
					<option value="phone">Phone app (Traccar Client, OsmAnd)</option>
				</options>
				<limitToOptions>true</limitToOptions>
				<default>fmb</default>
			</parameter>
			<parameter name="canAdapter" type="text">
				<label>CAN Adapter</label>
				<description>A Teltonika CAN adapter on the tracker (ALL-CAN300, LV-CAN200). With "lvcan" the device
					gets the CAN channel group, and the OBD-II reading of io30-io48 is switched off, because the
					adapter uses the same io numbers for other values. Tested with an FMx6 tracker.</description>
				<options>
					<option value="none">None</option>
					<option value="lvcan">LVCAN (ALL-CAN300, LV-CAN200)</option>
				</options>
				<limitToOptions>true</limitToOptions>
				<default>none</default>
			</parameter>
			<parameter name="obdDongle" type="text">
				<label>OBD-II Dongle</label>
				<description>Read io30-io48 as OBD-II data from a Bluetooth OBD-II dongle (the behaviour of every
					earlier release). Set to "none" on a tracker without one, so those io numbers are not shown
					under OBD-II names.</description>
				<options>
					<option value="bluetooth">Bluetooth OBD-II dongle</option>
					<option value="none">None</option>
				</options>
				<limitToOptions>true</limitToOptions>
				<default>bluetooth</default>
				<advanced>true</advanced>
			</parameter>
			<parameter name="gearParkWhenOff" type="boolean">
				<label>Parked When Switched Off</label>
				<description>CAN adapter only. Treat the car as parked whenever it is not ready to drive: no gear bit
					reads as P, and speed and accelerator pedal read 0 (the car sends them only while ready, so the
					last values before switch-off would otherwise stand for the whole stop). Right for cars that
					engage P themselves (most electric cars and automatics), wrong for a manual gearbox.</description>
				<default>false</default>
				<advanced>true</advanced>
			</parameter>
		</config-description>
	</thing-type>

	<!-- CAN adapter channels: added to a device only with canAdapter=lvcan -->
